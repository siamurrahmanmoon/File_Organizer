{
    "dry_run": true,
    "process_subfolders": true,
    "auto_folder_year": true,
    "skip_existing_year": true,
    "ask_user_input": false,
    "safe_mode": true,
    "move_files": true,
    "enable_metadata": true,
    "enable_parser": true,
    "enable_duplicates": true,
    "enable_filters": true,
    "enable_templates": true,
    "enable_rollback": true,
    "enable_quality_control": true,
    "enable_subtitles": true,
    "enable_watch_folder": false,
    "enable_notifications": true,
    "enable_analytics": true,
    "naming_template": "{Title} ({Year}) [{Languages}] [{Resolution}] - S{Season}E{Episode}",
    "include_resolution": true,
    "include_video_codec": false,
    "include_audio_codec": false,
    "include_audio_channels": false,
    "include_audio_language": true,
    "include_bitrate": false,
    "include_fps": false,
    "duplicate_action": "quarantine",
    "hash_algorithm": "fast"
}
