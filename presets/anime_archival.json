{
    "dry_run": true,
    "process_subfolders": true,
    "auto_folder_year": true,
    "skip_existing_year": false,
    "ask_user_input": false,
    "safe_mode": true,
    "move_files": true,
    "enable_metadata": true,
    "enable_parser": true,
    "enable_duplicates": true,
    "enable_filters": true,
    "enable_templates": true,
    "enable_rollback": true,
    "enable_quality_control": true,
    "enable_subtitles": true,
    "naming_template": "[{Group}] {Title} ({Year}) [{Languages}] [{Resolution}] [{Codec}] [{AudioCodec} {AudioChannels}] - S{Season}E{Episode}",
    "include_resolution": true,
    "include_video_codec": true,
    "include_audio_codec": true,
    "include_audio_channels": true,
    "include_audio_language": true,
    "include_bitrate": false,
    "include_fps": false
}
